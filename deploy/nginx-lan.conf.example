# IP-only campus deployment approved by the owner. HTTP is not encrypted.
# This service owns 8083. The existing 8080 gateway forwards /workbench/ here.
log_format workbench_path '$remote_addr $request_method $uri $status $request_time';
server {
    listen 8083;
    server_name _;
    root /opt/BME_workbench/frontend/dist;
    client_max_body_size 26m;
    access_log /var/log/nginx/workbench.access.log workbench_path;
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    location = / { return 302 http://172.25.56.83:8080/workbench/; }
    location ^~ /workbench/api/ {
        proxy_pass http://127.0.0.1:5003/api/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 20s;
    }
    location ^~ /workbench/ {
        rewrite ^/workbench/(.*)$ /$1 break;
        try_files $uri $uri/ /index.html;
    }
    location = /index.html { add_header Cache-Control no-store; }
    location / { return 404; }
}

