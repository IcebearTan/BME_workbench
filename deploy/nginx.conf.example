# Reference configuration only. Replace domain, paths and certificate locations.
# Place log_format in the nginx http context (not inside server).
# Use $uri rather than $request_uri so SSO callback codes are not logged.
log_format workbench_minimal '$remote_addr $request_method $uri $status $request_time';

server {
    listen 443 ssl;
    server_name workbench.example.invalid;
    ssl_certificate /etc/ssl/workbench/fullchain.pem;
    ssl_certificate_key /etc/ssl/workbench/privkey.pem;
    root /srv/bme-workbench/frontend/dist;
    index index.html;
    access_log /var/log/nginx/workbench.access.log workbench_minimal;
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;

    location /api/ {
        proxy_pass http://127.0.0.1:5003;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 15s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
