# Copy to .env; generate a unique secret locally. No production credentials here.
WORKBENCH_ENV=development
WORKBENCH_SECRET_KEY=
WORKBENCH_PUBLIC_ORIGIN=http://127.0.0.1:8083
# Default is an isolated SQLite file in backend/instance/workbench.db.
# Production: mysql+pymysql://USER:PASSWORD@HOST:3306/bme_workbench?charset=utf8mb4
# WORKBENCH_DATABASE_URL=

# Keep disabled until the training-platform contract is implemented and reviewed.
IDENTITY_PROVIDER_MODE=disabled
IDENTITY_ISSUER=
IDENTITY_CLIENT_ID=
IDENTITY_CLIENT_SECRET=
IDENTITY_AUTHORIZE_URL=
IDENTITY_EXCHANGE_URL=
IDENTITY_STATUS_URL=
